ENV=dev
TRUST_GATEWAY=true
LOG_LEVEL=INFO
# text = linha legível (cores em dev); json = uma linha JSON por evento
LOG_FORMAT=text
LOG_STARTUP_BANNER=false

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

KEYCLOAK_URL=
KEYCLOAK_ISSUER=http://localhost:8100/keycloak
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

ALGORITHM=RS256
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TOKEN_SECRET=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=

AWS_BUCKET_REGION=
AWS_BUCKET_NAME=
AWS_BUCKET_ACCESS_KEY_ID=
AWS_BUCKET_SECRET_ACCESS_KEY=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8100"]

# Server-to-server via Kong (paths /api/... são concatenados no código)
NOTIFICATIONS_SERVICE_URL=http://localhost:8100
COMPETITIONS_SERVICE_URL=http://localhost:8100
NOTIFICATIONS_INTERNAL_API_KEY=

# Mensageria (notificações internas). Ex.: amqp://athlos:athlos@localhost:5672/
RABBITMQ_URL=

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30
