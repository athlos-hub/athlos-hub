ENV=dev
TRUST_GATEWAY=true
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_STARTUP_BANNER=false

DATABASE_HOST=
DATABASE_PORT=5436
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

PORT=8004

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

FRONTEND_BASE_URL=http://localhost:3000

# Google Cloud Console → APIs e serviços → Credenciais → Criar ID do cliente OAuth → "Aplicativo da Web".
# Em "URIs de redirecionamento autorizados", adicione EXATAMENTE (inclui Kong em dev):
#   http://localhost:8100/api/google-calendar/oauth/callback
# Copie o ID do cliente e o segredo do cliente (não use cliente "Área restrita" sem secret).
# Se aparecer invalid_client: segredo errado, cliente errado ou espaço extra no .env — regenere o secret no Console se precisar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8100/api/google-calendar/oauth/callback

AUTH_SERVICE_URL=http://localhost:8100
COMPETITIONS_SERVICE_URL=http://localhost:8100
