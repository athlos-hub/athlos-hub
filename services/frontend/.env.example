# Gateway Kong (local :8100 → serviços). Rotas /api/...
ENV=dev

NEXT_PUBLIC_API_BASE_URL=http://localhost:8100/api
API_BASE_URL=http://localhost:8100/api

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bases usadas por getServiceURL() em dev (auth + competições via Kong)
AUTH_API_URL=http://localhost:8100
COMPETITIONS_API_URL=http://localhost:8100/api

# Rewrite next.config: /api/social → Kong
SOCIAL_SERVICE_URL=http://localhost:8100

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Socket.IO e HLS via Kong; scoreboard WS
NEXT_PUBLIC_LIVESTREAM_WS_URL=http://localhost:8100
NEXT_PUBLIC_HLS_URL=http://localhost:8100
NEXT_PUBLIC_SCOREBOARD_WS_URL=http://localhost:8100/api

NEXT_PUBLIC_RTMP_SERVER_URL=rtmp://localhost
NEXT_PUBLIC_MEDIAMTX_RTMP_PORT=1935

NEXT_ALLOWED_ORIGINS=localhost:3000,localhost:8100
