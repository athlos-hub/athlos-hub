# =============================================================================
# SOCIAL SERVICE - Configurações de Ambiente
# =============================================================================
# Este arquivo serve como template. Copie para .env e ajuste os valores.
# 
# ORDEM DE PRECEDÊNCIA (do maior para o menor):
# 1. Variáveis de ambiente do sistema
# 2. .env local (services/social-service/.env)
# 3. .env.development da raiz (athlos-hub/.env.development) 
# 4. .env da raiz (athlos-hub/.env)
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Estas variáveis normalmente vêm do .env da raiz do projeto
# Se precisar sobrescrever localmente, descomente e ajuste:

# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=social_db
# DATABASE_USER=social_user
# DATABASE_PASSWORD=sOPA5ySJAZcSlHT60NOFEqEhRBMMnAfI

# Ou use as variáveis específicas do social-service:
SOCIAL_DB_USER=social_user
SOCIAL_DB_PASSWORD=sOPA5ySJAZcSlHT60NOFEqEhRBMMnAfI

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0

# -----------------------------------------------------------------------------
# KEYCLOAK CONFIGURATION
# -----------------------------------------------------------------------------
# Normalmente vêm do .env da raiz, mas podem ser sobrescritos:
# KEYCLOAK_ISSUER_URI=http://localhost:8080
# KEYCLOAK_REALM=athloshub

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Lista separada por vírgulas de origens permitidas
# Use "*" para desenvolvimento, URLs específicas em produção
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Configurar origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# MICROSERVICES URLS
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8000
COMPETITIONS_SERVICE_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
SERVER_PORT=8083
# API_PORT=8083  # Alternativa compatível com outros serviços

# -----------------------------------------------------------------------------
# SPRING PROFILES
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# DATABASE POOL
# -----------------------------------------------------------------------------
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_SIZE=5
DB_CONNECTION_TIMEOUT=30000

# -----------------------------------------------------------------------------
# JPA/HIBERNATE
# -----------------------------------------------------------------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_BATCH_SIZE=20

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
SECURITY_LOG_LEVEL=DEBUG
SQL_LOG_LEVEL=DEBUG
SQL_BINDER_LOG_LEVEL=TRACE
FEIGN_LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# ACTUATOR & MONITORING
# -----------------------------------------------------------------------------
ACTUATOR_ENDPOINTS=health,info,metrics,prometheus
ACTUATOR_HEALTH_DETAILS=always
PROMETHEUS_ENABLED=true

# -----------------------------------------------------------------------------
# SWAGGER/OPENAPI
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# FEIGN CLIENT
# -----------------------------------------------------------------------------
FEIGN_CONNECT_TIMEOUT=5000
FEIGN_READ_TIMEOUT=5000

