# Database (use NOTIFICATIONS_DATABASE_URL or DATABASE_URL)
NOTIFICATIONS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notifications_db
NOTIFICATIONS_DATABASE_SCHEMA=
NOTIFICATIONS_DATABASE_USER=
NOTIFICATIONS_DATABASE_PASSWORD=

# Chave compartilhada com auth-service, social-service e competitions-service
NOTIFICATIONS_INTERNAL_API_KEY=dev-notifications-internal-key

# Service
SERVICE_NAME=notifications-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8003
DEBUG=True
ENV=dev

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8100

# Auth (validação do Bearer via GET /users/me)
AUTH_SERVICE_URL=http://localhost:8000
